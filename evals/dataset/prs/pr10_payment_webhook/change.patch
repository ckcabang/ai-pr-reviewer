+@router.post("/payments")
+async def payment_event(request: Request, x_signature: str = Header(default="")):
+    """Payment gateway callback: marks the order refunded when the gateway refunds a charge."""
+    raw = await request.body()
+    if sign(raw, get_settings().webhook_secret) != x_signature:
+        raise HTTPException(status_code=401, detail="Invalid signature")
+
+    try:
+        event = json.loads(raw)
+        logger.info("payment webhook %s", redact(event))
+        if event["type"] not in PAYMENT_EVENTS:
+            raise HTTPException(status_code=422, detail="Unsupported event type")
+        row = db.execute(
+            "SELECT order_id FROM payments WHERE charge_id = ?", (event["charge_id"],)
+        ).one()
+        if row is None:
+            raise HTTPException(status_code=404, detail="Unknown charge")
+        order = orders.get_order(row["order_id"])
+        order_state.transition(order, "refunded")
+    except HTTPException:
+        raise
+    except order_state.InvalidTransition:
+        raise HTTPException(status_code=409, detail="Order cannot move to that state")
+    except Exception as exc:
+        logger.exception("payment webhook failed")
+        raise HTTPException(status_code=400, detail=f"Could not process webhook: {exc}")
+    return {"order_id": order["id"], "status": order["status"]}
