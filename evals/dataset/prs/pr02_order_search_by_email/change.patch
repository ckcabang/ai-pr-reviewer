+def search_orders_by_email(email: str) -> list[dict]:
+    """Orders whose customer's email contains `email` (case-insensitive substring match)."""
+    rows = db.execute(
+        "SELECT o.id, o.user_id, o.status, o.discount_code FROM orders o "
+        "JOIN users u ON u.id = o.user_id "
+        f"WHERE LOWER(u.email) LIKE '%{email.lower()}%' ORDER BY o.id"
+    ).all()
+    return [dict(r) for r in rows]
+
