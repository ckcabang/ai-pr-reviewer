+def list_orders_page(user_id: int, limit: int, offset: int) -> list[dict]:
+    rows = db.execute(
+        "SELECT id, user_id, status, discount_code FROM orders WHERE user_id = ? ORDER BY id LIMIT ? OFFSET ?",
+        (user_id, limit, offset),
+    ).all()
+    return [dict(r) for r in rows]
