+def test_list_orders_is_scoped_to_the_caller_and_honours_page_size(client, stocked, create_user, auth_headers):
+    user = create_user()
+    other = create_user("bob@example.com")
+    headers = auth_headers(user)
+    for _ in range(3):
+        _place_order(client, headers, qty=1)
+    assert client.get("/orders", params={"page_size": 2}, headers=auth_headers(other)).json() == []
+    resp = client.get("/orders", params={"page_size": 1}, headers=headers)
+    assert resp.status_code == 200 and len(resp.json()) <= 1
+    assert all(o["user_id"] == user for o in resp.json())
+
+
