+def reserve_for_cart(sku: str, quantity: int) -> InventoryOut:
+    """Hold `quantity` units for a shopper's cart and return the item with its remaining stock."""
+    item = get_item(sku)
+    if item is None:
+        raise UnknownSku(sku)
+    if item.stock < 0:
+        raise OutOfStock(sku)
+    db.execute("UPDATE inventory SET stock = ? WHERE sku = ?", (item.stock - quantity, sku))
+    return get_item(sku)
+
