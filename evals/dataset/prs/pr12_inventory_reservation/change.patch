diff --git a/tests/test_inventory.py b/tests/test_inventory.py
new file mode 100644
index 0000000..1bf52b0
--- /dev/null
+++ b/tests/test_inventory.py
@@ -0,0 +1,24 @@
+import pytest
+
+from app import db
+
+
+@pytest.fixture
+def stocked():
+    db.execute("INSERT INTO inventory (sku, name, price, stock) VALUES ('W-1', 'Widget', '10.00', 5)")
+
+
+def test_reserve_requires_authentication(client, stocked):
+    assert client.post("/inventory/W-1/reserve", json={"quantity": 1}).status_code == 401
+
+
+def test_reserve_takes_units_out_of_stock(client, stocked, create_user, auth_headers):
+    headers = auth_headers(create_user())
+    resp = client.post("/inventory/W-1/reserve", json={"quantity": 2}, headers=headers)
+    assert resp.status_code == 200 and resp.json()["stock"] == 3
+    assert client.get("/inventory/W-1", headers=headers).json()["stock"] == 3
+
+
+def test_reserve_unknown_sku_is_404(client, create_user, auth_headers):
+    resp = client.post("/inventory/NOPE/reserve", json={"quantity": 1}, headers=auth_headers(create_user()))
+    assert resp.status_code == 404
