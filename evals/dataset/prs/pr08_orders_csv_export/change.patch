@@ -0,0 +1,31 @@
+import csv
+
+import pytest
+
+from app import db
+
+
+@pytest.fixture
+def two_orders(create_user):
+    db.execute("INSERT INTO inventory (sku, name, price, stock) VALUES ('W-1', 'Widget', '10.00', 20)")
+    for user in (create_user("ann@example.com"), create_user("bob@example.com")):
+        order_id = db.execute("INSERT INTO orders (user_id) VALUES (?)", (user,)).lastrowid
+        db.execute(
+            "INSERT INTO order_items (order_id, sku, quantity, unit_price) VALUES (?, 'W-1', 2, '10.00')",
+            (order_id,),
+        )
+
+
+def test_csv_export_lists_every_order(client, two_orders, tmp_path):
+    resp = client.get("/exports/orders/csv")
+    assert resp.status_code == 200 and resp.headers["content-type"].startswith("text/csv")
+    rows = list(csv.reader((tmp_path / "exports" / "orders.csv").read_text().splitlines()))
+    assert rows[0] == ["order_id", "user_id", "status", "total", "items"]
+    assert [r[0] for r in rows[1:]] == ["1", "2"]
+    assert rows[1][3] == "21.65"
+
+
+def test_csv_export_uses_the_requested_filename(client, two_orders, tmp_path):
+    resp = client.get("/exports/orders/csv", params={"filename": "march.csv"})
+    assert resp.status_code == 200
+    assert (tmp_path / "exports" / "march.csv").exists()
