+@router.put("/{user_id}/address", response_model=UserOut)
+def update_shipping_address(user_id: int, body: AddressUpdate):
+    """Set the address that shipments for this user's orders are sent to."""
+    result = db.execute(
+        "UPDATE users SET shipping_address = ? WHERE id = ?", (body.shipping_address.strip(), user_id)
+    )
+    if result.rowcount == 0:
+        raise HTTPException(status_code=404, detail="User not found")
+    return _load_user(user_id)
diff --git a/tests/test_shipping_address.py b/tests/test_shipping_address.py
new file mode 100644
index 0000000..a19ecbb
--- /dev/null
+++ b/tests/test_shipping_address.py
@@ -0,0 +1,16 @@
+def test_shipping_address_can_be_set_and_read_back(client, create_user, auth_headers):
+    user = create_user()
+    resp = client.put(f"/users/{user}/address", json={"shipping_address": " 12 Elm Street, Springfield "})
+    assert resp.status_code == 200
+    assert resp.json()["shipping_address"] == "12 Elm Street, Springfield"
+    assert client.get(f"/users/{user}", headers=auth_headers(user)).json()["shipping_address"] == "12 Elm Street, Springfield"
+
+
+def test_shipping_address_for_unknown_user_is_404(client):
+    resp = client.put("/users/999/address", json={"shipping_address": "12 Elm Street, Springfield"})
+    assert resp.status_code == 404
+
+
+def test_too_short_shipping_address_is_rejected(client, create_user):
+    user = create_user()
+    assert client.put(f"/users/{user}/address", json={"shipping_address": "x"}).status_code == 422
