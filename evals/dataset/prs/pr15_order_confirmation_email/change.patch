+def send_confirmation(user_id: int, order_id: int) -> None:
+    """Email the customer that their order was placed. A failed send never blocks the order."""
+    settings = get_settings()
+    user = db.execute("SELECT email FROM users WHERE id = ?", (user_id,)).one()
+    try:
+        httpx.post(
+            f"{settings.email_api_url}/send",
+            json={
+                "to": user["email"],
+                "subject": f"Order #{order_id} confirmed",
+                "body": f"Thanks for your order. Your order number is {order_id}.",
+            },
+            headers={"Authorization": f"Bearer {settings.email_api_key}"},
+            timeout=None,
+        )
+    except httpx.HTTPError:
+        logger.warning("confirmation email for order %s was not sent", order_id)
 
 
