diff --git a/tests/test_login_logging.py b/tests/test_login_logging.py
new file mode 100644
index 0000000..1aff4f9
--- /dev/null
+++ b/tests/test_login_logging.py
@@ -0,0 +1,28 @@
+import logging
+
+
+def _register(client):
+    client.post("/users", json={"email": "ann@example.com", "full_name": "Ann", "password": "long-enough-pw"})
+
+
+def test_failed_login_for_unknown_account_is_logged(client, caplog):
+    with caplog.at_level(logging.WARNING, logger="app.routes.users"):
+        resp = client.post("/users/login", json={"email": "ghost@example.com", "password": "whatever-pw"})
+    assert resp.status_code == 401
+    assert "unknown account" in caplog.text and "ghost@example.com" in caplog.text
+
+
+def test_failed_login_for_known_account_is_logged_with_the_user_id(client, caplog):
+    _register(client)
+    with caplog.at_level(logging.WARNING, logger="app.routes.users"):
+        resp = client.post("/users/login", json={"email": "ann@example.com", "password": "wrong-password"})
+    assert resp.status_code == 401
+    assert "failed login attempt for user 1" in caplog.text
+
+
+def test_successful_login_is_not_logged_as_a_failure(client, caplog):
+    _register(client)
+    with caplog.at_level(logging.WARNING, logger="app.routes.users"):
+        resp = client.post("/users/login", json={"email": "ann@example.com", "password": "long-enough-pw"})
+    assert resp.status_code == 200
+    assert "failed login" not in caplog.text
