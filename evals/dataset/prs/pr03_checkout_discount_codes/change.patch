+
+
+def quote_checkout(items: list[OrderItemIn], discount_code: str | None = None) -> Quote:
+    """Price a basket before an order exists, so checkout can show the discount and tax up front."""
+    subtotal = 0.0
+    for item in items:
+        stocked = inventory.get_item(item.sku)
+        if stocked is None:
+            raise inventory.UnknownSku(item.sku)
+        subtotal += float(stocked.price) * item.quantity
+    discount = 0.0
+    if discount_code:
+        percent = float(get_discount_percent(discount_code))
+        discount = subtotal * percent / 100
+    taxable = subtotal - discount
+    tax = taxable * float(get_settings().tax_rate)
+    return Quote(
+        subtotal=round(subtotal, 2),
+        discount=round(discount, 2),
+        tax=round(tax, 2),
+        total=round(taxable + tax, 2),
+    )
diff --git a/tests/test_checkout_quote.py b/tests/test_checkout_quote.py
new file mode 100644
index 0000000..44e6520
--- /dev/null
+++ b/tests/test_checkout_quote.py
@@ -0,0 +1,43 @@
+from decimal import Decimal
+
+import pytest
+
+from app import db
+
+
+@pytest.fixture
+def catalog():
+    db.execute("INSERT INTO inventory (sku, name, price, stock) VALUES ('W-1', 'Widget', '10.00', 20)")
+    db.execute("INSERT INTO discount_codes (code, percent_off) VALUES ('SAVE25', '25')")
+
+
+def _quote(client, headers, **body):
+    body.setdefault("items", [{"sku": "W-1", "quantity": 2}])
+    return client.post("/orders/quote", json=body, headers=headers)
+
+
+def test_quote_requires_authentication(client):
+    assert client.post("/orders/quote", json={"items": [{"sku": "W-1", "quantity": 1}]}).status_code == 401
+
+
+def test_quote_without_a_code_adds_tax_only(client, catalog, create_user, auth_headers):
+    resp = _quote(client, auth_headers(create_user()))
+    assert resp.status_code == 200
+    body = resp.json()
+    assert Decimal(body["subtotal"]) == Decimal("20.00")
+    assert Decimal(body["discount"]) == Decimal("0.00")
+    assert Decimal(body["total"]) == Decimal("21.65")
+
+
+def test_quote_applies_a_percentage_code_before_tax(client, catalog, create_user, auth_headers):
+    resp = _quote(client, auth_headers(create_user()), discount_code="SAVE25")
+    body = resp.json()
+    assert Decimal(body["discount"]) == Decimal("5.00")
+    assert Decimal(body["tax"]) == Decimal("1.24")
+    assert Decimal(body["total"]) == Decimal("16.24")
+
+
+def test_quote_rejects_unknown_codes_and_items(client, catalog, create_user, auth_headers):
+    headers = auth_headers(create_user())
+    assert _quote(client, headers, discount_code="NOPE").status_code == 400
+    assert _quote(client, headers, items=[{"sku": "X-9", "quantity": 1}]).status_code == 404
