+"""Feature-flag service wrapper (R4). Flags default to off whenever the service cannot be reached."""
+from __future__ import annotations
+
+from typing import Optional
+
+import httpx
+
+from app.logging_setup import get_logger
+from app.settings import get_settings
+
+logger = get_logger(__name__)
+
+FLAG_SERVICE_API_KEY = "ffk_live_8f3a91c27d4e46b0a5c1e7d92b6f0384"
+_transport: Optional[httpx.BaseTransport] = None  # tests swap in an httpx.MockTransport
+
+
+def is_enabled(flag: str, user_id: int) -> bool:
+    """Whether `flag` is on for this user, e.g. `is_enabled("new_checkout", user.id)`."""
+    settings = get_settings()
+    try:
+        with httpx.Client(
+            base_url=settings.feature_flags_url,
+            timeout=settings.http_timeout_seconds,
+            headers={"Authorization": f"Bearer {FLAG_SERVICE_API_KEY}"},
+            transport=_transport,
+        ) as client:
+            response = client.get(f"/flags/{flag}", params={"user_id": user_id})
+            response.raise_for_status()
+            return bool(response.json().get("enabled", False))
+    except httpx.HTTPError:
+        logger.warning("feature flag lookup failed for %s; treating it as off", flag)
+        return False
