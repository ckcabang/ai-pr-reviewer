+++ b/tests/test_feature_flags.py
@@ -0,0 +1,27 @@
+import httpx
+import pytest
+
+from app.clients import feature_flags
+
+
+@pytest.fixture(autouse=True)
+def reset_transport():
+    yield
+    feature_flags._transport = None
+
+
+def test_flag_value_comes_from_the_service():
+    seen = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        seen.append(request.url.path)
+        return httpx.Response(200, json={"enabled": True})
+
+    feature_flags._transport = httpx.MockTransport(handler)
+    assert feature_flags.is_enabled("new_checkout", 7) is True
+    assert seen == ["/flags/new_checkout"]
+
+
+def test_flag_is_off_when_the_service_is_down():
+    feature_flags._transport = httpx.MockTransport(lambda request: httpx.Response(503))
+    assert feature_flags.is_enabled("new_checkout", 7) is False
